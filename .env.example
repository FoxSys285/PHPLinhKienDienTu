APP_NAME="Linh Kien"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Set these from your PayOS channel. APP_URL must be public HTTPS; register APP_URL/thanh-toan/payos/webhook as the webhook URL.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Demo drivers do not require the real provider credentials above.
# Switch to payos/live only after configuring provider credentials and webhooks.
PAYMENT_DRIVER=mock

# Viettel Post Partner webhook. Keep disabled until the payload field names and status codes
# are confirmed in your Partner account; configure the endpoint shown in BUSSINESS.md.
VIETTELPOST_WEBHOOK_ENABLED=false
VIETTELPOST_DRIVER=mock
VIETTELPOST_WEBHOOK_SECRET=
VIETTELPOST_WEBHOOK_TRACKING_FIELD=tracking_number
VIETTELPOST_WEBHOOK_ORDER_FIELD=order_number
VIETTELPOST_WEBHOOK_STATUS_FIELD=status
VIETTELPOST_WEBHOOK_EVENT_FIELD=event_id
VIETTELPOST_WEBHOOK_DESCRIPTION_FIELD=description
VIETTELPOST_WEBHOOK_TIME_FIELD=occurred_at
VIETTELPOST_STATUS_MAP_JSON={}

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

STORE_ADMIN_EMAIL=admin@linhkien.local
STORE_ADMIN_PASSWORD=ChangeMe123!
STORE_SHIPPING_FEE=30000
STORE_FREE_SHIPPING_THRESHOLD=500000
STORE_VAT_RATE=0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
